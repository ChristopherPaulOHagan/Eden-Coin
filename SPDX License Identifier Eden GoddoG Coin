pragma solidity ^0.8.20;  

import "@openzeppelin/contracts/utils/Strings.sol";
import "@openzeppelin/contracts/utils/Base64.sol";

contract EdenGoddoGCoin {  
    using Strings for uint256;

    // 1. Global Core Variables
    string public constant name = "EDEN GoddoG COIN";  
    string public constant symbol = "EDGG";  
    uint256 public totalSupply = 8_000_000_000 * 10**18;  
    address public globalGovernor;

    // 2. Dixie Legacy Registry & Insurance Parameters
    string public constant DIXIE_MEMORIAL_ID = "DXE BRK 2011";
    uint256 public insurancePremiumTokens; // Equivalent to $10 USD in EDGG tokens

    // 3. Ledger Registries
    mapping(address => uint256) public balanceOf;  
    mapping(address => uint256) public lastPremiumPayment;
    mapping(address => bool) public isInsured;
    mapping(address => bool) public verifiedVeterinarians;

    // 4. Case Tracking Systems (Emergency Vet Grants)
    uint256 public totalEmergencyClaims;
    mapping(uint256 => address) public claimRecipient;
    mapping(uint256 => uint256) public claimAmount;
    mapping(uint256 => bool) public claimSettled;

    // 5. System Event Logs
    event Transfer(address indexed _from, address indexed _to, uint256 _value);  
    event InsurancePremiumPaid(address indexed PetOwner, uint256 Timestamp);
    event VetEmergencyClaimFiled(uint256 indexed ClaimID, address indexed PetOwner, uint256 Amount);
    event VetEmergencyClaimPaid(uint256 indexed ClaimID, address indexed Veterinarian, uint256 Amount);

    // 6. Architecture Constructor
    constructor(uint256 _initialPremiumTokenAmount) { 
        balanceOf[msg.sender] = totalSupply; 
        globalGovernor = msg.sender; 
        insurancePremiumTokens = _initialPremiumTokenAmount * 10**18;
    }  

    // 7. Core Transaction Engine
    function transfer(address _to, uint256 _value) public returns (bool) {  
        require(balanceOf[msg.sender] >= _value, "Insufficient balance");  
        
        balanceOf[msg.sender] -= _value;  
        balanceOf[_to] += _value;  
        
        emit Transfer(msg.sender, _to, _value);  
        return true;  
    }  

    // 8. The GoddoG Insurance Loop ($10/Month Value Anchor)
    function payMonthlyPremium() public {
        require(balanceOf[msg.sender] >= insurancePremiumTokens, "Insufficient EDGG to cover premium");
        
        balanceOf[msg.sender] -= insurancePremiumTokens;
        balanceOf[address(this)] += insurancePremiumTokens; // Retained inside the insurance vault
        
        lastPremiumPayment[msg.sender] = block.timestamp;
        isInsured[msg.sender] = true;
        
        emit InsurancePremiumPaid(msg.sender, block.timestamp);
    }

    // 9. Emergency Vet Payout Engine (The Vet Defense Shield)
    // Allows the global governor to bypass overhead barriers and route funds directly to clear vet bills
    function fileEmergencyClaim(address _petOwner, uint256 _amountToCover) public {
        require(msg.sender == globalGovernor, "Only the global referee can authorize emergency claims");
        require(isInsured[_petOwner] || balanceOf[address(this)] >= _amountToCover, "Claim parameters exceed safety treasury thresholds");

        totalEmergencyClaims++;
        claimRecipient[totalEmergencyClaims] = _petOwner;
        claimAmount[totalEmergencyClaims] = _amountToCover;
        claimSettled[totalEmergencyClaims] = false;

        emit VetEmergencyClaimFiled(totalEmergencyClaims, _petOwner, _amountToCover);
    }

    function settleClaimToVet(uint256 _claimId, address _vetAddress) public {
        require(msg.sender == globalGovernor, "Only the global referee can dispatch vet payments");
        require(verifiedVeterinarians[_vetAddress], "Target clinic must be a verified node");
        require(!claimSettled[_claimId], "Claim has already been settled");
        require(balanceOf[address(this)] >= claimAmount[_claimId], "Vault treasury requires replenishment from stagnation pools");

        claimSettled[_claimId] = true;
        balanceOf[address(this)] -= claimAmount[_claimId];
        balanceOf[_vetAddress] += claimAmount[_claimId];

        emit VetEmergencyClaimPaid(_claimId, _vetAddress, claimAmount[_claimId]);
    }

    // 10. Microcode Legacy Representation Token Engine
    function generateNoteText(uint256 _claimId) public view returns (string memory) {
        return string(abi.encodePacked(
            "..........................................\n",
            "....\xE2\x88\x91\xE2\x88\x91\xE2\x88\x91 EDEN GoddoG EMERGENCY VET GRANT \xE2\x88\x91\xE2\x88\x91\xE2\x88\x91....\n",
            "..........................................\n",
            "   Legacy ID: ", DIXIE_MEMORIAL_ID, "\n",
            "   Claim Reference ID: #", _claimId.toString(), "\n",
            "   Allocation Value: ", claimAmount[_claimId].toString(), " EDGG\n",
            "   Status: Emergency Overhead Bypassed\n",
            "..........................................\n",
            " <Funds deployed directly to prevent unnecessary loss of life>\n",
            "..........................................\n"
        ));
    }

    function tokenURI(uint256 _claimId) public view returns (string memory) {
        require(claimSettled[_claimId], "Claim asset statement not generated yet");
        string memory rawText = generateNoteText(_claimId);
        string memory json = string(abi.encodePacked(
            '{"name": "GoddoG Emergency Asset #', _claimId.toString(), '", ',
            '"description": "Verifiable Emergency Veterinary Coverage", ',
            '"raw_layout": "', rawText, '"}'
        ));
        return string(abi.encodePacked("data:application/json;base64,", Base64.encode(bytes(json))));
    }

    // 11. Governance Infrastructure Switches
    function setVerifiedVeterinarian(address _vet, bool _status) public {
        require(msg.sender == globalGovernor, "Only the global referee can verify veterinary nodes");
        verifiedVeterinarians[_vet] = _status;
    }

    function adjustPremiumRate(uint256 _newTokenAmount) public {
        require(msg.sender == globalGovernor, "Only the global referee can recalibrate the premium peg");
        insurancePremiumTokens = _newTokenAmount * 10**18;
    }
}
